FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

# Base tooling
RUN apt-get update && apt-get install -y software-properties-common curl

# ROS 2 Jazzy apt source
RUN add-apt-repository universe
RUN curl -L -o /tmp/ros2-apt-source.deb \
    "https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.1.0/ros2-apt-source_1.1.0.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb"
RUN dpkg -i /tmp/ros2-apt-source.deb

# Install ROS 2 + dependencies
RUN apt-get update && apt-get install -y \
    ros-jazzy-ros-base \
    ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-rosbag2 \
    ros-jazzy-rosbag2-storage-default-plugins \
    ros-jazzy-sensor-msgs \
    ros-jazzy-std-msgs \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/* /tmp/ros2-apt-source.deb

RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc

# Set up workspace
WORKDIR /opt/ros2ws
RUN mkdir -p src img

# Copy the estop package
COPY ros2ws/src/estop_pkg ./src/estop_pkg

# Build
SHELL ["/bin/bash", "-c"]
RUN source /opt/ros/jazzy/setup.bash && \
    colcon build --packages-select estop_pkg

RUN echo "source /opt/ros2ws/install/setup.bash" >> ~/.bashrc

# Environment — match your global_controller setup
ENV ROS_DOMAIN_ID=8
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"wlp0s20f3\"/></Interfaces></General></Domain></CycloneDDS>"
ENV PYTHONUNBUFFERED=1

CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && source /opt/ros2ws/install/setup.bash && ros2 run estop_pkg estop_node"]
