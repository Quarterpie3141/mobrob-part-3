FROM ubuntu:24.04

RUN apt-get update && apt-get install -y software-properties-common curl

RUN add-apt-repository universe
RUN curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.1.0/ros2-apt-source_1.1.0.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb"
RUN dpkg -i /tmp/ros2-apt-source.deb

RUN apt-get update

RUN apt-get update && apt-get install -y \
    ros-jazzy-ros-base \
    ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-nav2-msgs \
    python3-colcon-common-extensions \
    python3-pip \
    python3-opencv

RUN pip3 install --break-system-packages numpy

RUN apt-get install ros-jazzy-ros-base ros-jazzy-rmw-cyclonedds-cpp python3-colcon-common-extensions -y


#cv_bridge
RUN apt install ros-jazzy-cv-bridge -y
RUN apt install ros-jazzy-vision-msgs -y

RUN rm -rf /var/lib/apt/lists/* /tmp/ros2-apt-source.deb

RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc




# Setup a minimal workspace that only contains the global_controller package.
WORKDIR /opt/ros2ws
RUN mkdir -p /opt/ros2ws/src

COPY ros2ws/src/global_controller /opt/ros2ws/src/global_controller
SHELL ["/bin/bash", "-c"]

RUN echo "source /opt/ros2ws/install/setup.bash" >> ~/.bashrc
RUN source /opt/ros/jazzy/setup.bash && colcon build --packages-select global_controller

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DOMAIN_ID=8
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"wlp0s20f3\"/></Interfaces></General></Domain></CycloneDDS>"

CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && source /opt/ros2ws/install/setup.bash && ros2 run global_controller apollo"]

# 1. Set the working directory to your workspace
WORKDIR /opt/ros2ws

# 2. Copy the specific package source code from your computer into the container
COPY ros2ws/src/global_controller ./src/global_controller

# 3. Build the package during the Docker image creation
RUN /bin/bash -c "source /opt/ros/jazzy/setup.bash && colcon build --packages-select global_controller"
ENV PYTHONUNBUFFERED=1