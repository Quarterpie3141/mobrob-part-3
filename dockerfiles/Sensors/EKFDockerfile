FROM ubuntu:24.04

RUN apt-get update && apt-get install -y software-properties-common curl

RUN add-apt-repository universe
RUN curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.1.0/ros2-apt-source_1.1.0.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb"
RUN dpkg -i /tmp/ros2-apt-source.deb

RUN apt-get update

RUN apt-get install -y ros-jazzy-ros-base ros-jazzy-rmw-cyclonedds-cpp ros-jazzy-robot-localization python3-colcon-common-extensions python3-pip libusb-1.0-0-dev

RUN rm -rf /var/lib/apt/lists/* /tmp/ros2-apt-source.deb

RUN apt-get update

RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc


# Setup a minimal workspace that only contains the sensor packages.
WORKDIR /opt/ros2ws
RUN mkdir -p /opt/ros2ws/src
COPY ros2ws/src/ekf_pkg /opt/ros2ws/src/ekf_pkg

SHELL ["/bin/bash", "-c"]
# Build only the packages needed for the combined launch.
RUN source /opt/ros/jazzy/setup.bash && colcon build --packages-select ekf_pkg

RUN echo "source /opt/ros2ws/install/setup.bash" >> ~/.bashrc

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DOMAIN_ID=8
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"wlp0s20f3\"/></Interfaces></General></Domain></CycloneDDS>"

# Start the combined IMU + EKF + lidar + raw GPS launch file when the container runs.
CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && source /opt/ros2ws/install/setup.bash && ros2 launch ekf_pkg launch_EKF.py"]