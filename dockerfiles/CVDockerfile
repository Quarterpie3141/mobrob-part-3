FROM ubuntu:24.04
RUN apt update && apt upgrade -y
RUN apt install software-properties-common -y
RUN add-apt-repository universe
#Luisa Dockerfile


#install ROS2 jazzy
RUN apt update && apt install curl -y
RUN export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F'"' '{print $4}')
RUN curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.1.0/ros2-apt-source_1.1.0.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb"
RUN dpkg -i /tmp/ros2-apt-source.deb
RUN apt update
RUN apt upgrade -y
RUN apt install ros-jazzy-ros-base -y

#cyclone 
RUN apt install ros-jazzy-rmw-cyclonedds-cpp -y

# Source ROS on container start
SHELL ["/bin/bash", "-c"]
RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc

# build essentials & ROS tools
RUN apt install git -y
RUN apt install build-essential -y
RUN apt install make g++ -y
RUN sh -c 'echo "deb [arch=amd64,arm64] http://repo.ros2.org/ubuntu/main `lsb_release -cs` main" > /etc/apt/sources.list.d/ros2-latest.list'
RUN curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | apt-key add -
RUN apt update
RUN apt install python3-colcon-common-extensions -y
RUN apt install libboost-all-dev -y
RUN apt install python3-pip -y
RUN apt install libusb-1.0-0-dev -y

#depthai
RUN python3 -m pip install depthai --break-system-packages

RUN apt update && apt install python3-pip python3-venv -y

RUN python3 -m venv /opt/venv --system-site-packages
ENV PATH="/opt/venv/bin:$PATH"

RUN /opt/venv/bin/pip install --upgrade pip setuptools wheel
RUN /opt/venv/bin/pip install "numpy<2"
RUN /opt/venv/bin/pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN /opt/venv/bin/pip install ultralytics --break-system-packages

#cv_bridge
RUN apt install ros-jazzy-cv-bridge -y
RUN apt install ros-jazzy-vision-msgs -y

#copy src dir and setup workspace
COPY ros2ws /opt/ros2ws
WORKDIR /opt/ros2ws

#env variables
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DOMAIN_ID=8
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"wlp0s20f3\"/></Interfaces></General></Domain></CycloneDDS>"

#build all packages in the workspace
RUN . /opt/ros/jazzy/setup.bash && /opt/venv/bin/python -m colcon build --packages-select cv --symlink-install 
RUN echo "source /opt/ros2ws/install/setup.bash" >> ~/.bashrc
#RUN source /opt/ros/jazzy/setup.bash && source /opt/ros2ws/install/setup.bash && ros2 run depthai_ros_publisher camera_node.py
CMD ["bash", "-lc", "source /opt/venv/bin/activate && source /opt/ros/jazzy/setup.bash && source /opt/ros2ws/install/setup.bash && ros2 run cv cv_node"]