FROM ubuntu:24.04

RUN apt-get update && apt-get install -y software-properties-common curl

RUN add-apt-repository universe
RUN curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.1.0/ros2-apt-source_1.1.0.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb"
RUN dpkg -i /tmp/ros2-apt-source.deb

RUN apt-get update

RUN apt-get install ros-jazzy-ros-base ros-jazzy-tf-transformations ros-jazzy-rmw-cyclonedds-cpp python3-colcon-common-extensions -y

RUN rm -rf /var/lib/apt/lists/* /tmp/ros2-apt-source.deb

RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc

# Setup a minimal workspace that only contains the basic_drive package.
WORKDIR /opt/ros2ws
RUN mkdir -p /opt/ros2ws/src
 


# RUN apt-get update && apt-get install -y python3-pip
# RUN pip3 install --break-system-packages --ignore-installed depthai

# RUN apt install python3-opencv -y

# #cv_bridge
# RUN apt install ros-jazzy-cv-bridge -y
# RUN apt install ros-jazzy-vision-msgs -y

# RUN apt remove python3-numpy -y
# RUN pip3 install --break-system-packages --ignore-installed "numpy<2"

#test
RUN apt-get update && apt-get install -y python3-pip
RUN pip3 install --break-system-packages --ignore-installed "numpy==1.26.4"  # pin exact version

RUN apt install python3-opencv -y
RUN apt install ros-jazzy-cv-bridge -y
RUN apt install ros-jazzy-vision-msgs -y
RUN pip3 install --break-system-packages --ignore-installed depthai          # depthai last

COPY ros2ws/src/image_publisher /opt/ros2ws/src/image_publisher
SHELL ["/bin/bash", "-c"]
RUN source /opt/ros/jazzy/setup.bash && colcon build --packages-select image_publisher

RUN echo "source /opt/ros2ws/install/setup.bash" >> ~/.bashrc


ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DOMAIN_ID=8
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"wlp0s20f3\"/></Interfaces></General></Domain></CycloneDDS>"

RUN apt install ros-jazzy-rmw-cyclonedds-cpp -y


# CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && source /opt/ros2ws/install/setup.bash && ros2 run image_publisher image_publisher_node"]
CMD ["bash", "-lc", "sleep 5 && source /opt/ros/jazzy/setup.bash && source /opt/ros2ws/install/setup.bash && ros2 run image_publisher image_publisher"]
