FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y software-properties-common curl

RUN add-apt-repository universe
RUN curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.1.0/ros2-apt-source_1.1.0.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb"
RUN dpkg -i /tmp/ros2-apt-source.deb

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ros-jazzy-ros-base \
    ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-ament-cmake \
    ros-jazzy-geometry-msgs \
    python3-colcon-common-extensions \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* /tmp/ros2-apt-source.deb

RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc

# Setup a minimal workspace that only contains the sensor packages.
WORKDIR /opt/ros2ws
RUN mkdir -p /opt/ros2ws/src
COPY ros2ws/src/moving_objects /opt/ros2ws/src/moving_objects
SHELL ["/bin/bash", "-c"]
# Build only the packages needed for the combined launch.
RUN source /opt/ros/jazzy/setup.bash && colcon build --packages-select moving_objects --event-handlers console_direct+

RUN echo "source /opt/ros2ws/install/setup.bash" >> ~/.bashrc

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DOMAIN_ID=8
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"wlp0s20f3\"/></Interfaces></General></Domain></CycloneDDS>"

# Start the combined IMU + EKF + lidar + raw GPS launch file when the container runs.
CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && source /opt/ros2ws/install/setup.bash && ros2 run moving_objects find_moving_objects"]